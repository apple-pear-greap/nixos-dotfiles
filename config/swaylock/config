# swaylock-effects: blurred desktop with Dracula colors.
# No grace period: authentication is required immediately.
daemonize
screenshots
effect-blur=7x5
effect-vignette=0.5:0.5
color=282a36

clock
timestr=%H:%M
datestr=%Y-%m-%d
font=Maple Mono NF CN
font-size=24

indicator
indicator-radius=100
indicator-thickness=7
line-uses-ring
inside-color=282a36cc
ring-color=bd93f9
key-hl-color=50fa7b
bs-hl-color=ffb86c
separator-color=00000000
text-color=f8f8f2

inside-ver-color=282a36cc
ring-ver-color=8be9fd
text-ver-color=8be9fd
inside-wrong-color=282a36cc
ring-wrong-color=ff5555
text-wrong-color=ff5555
inside-clear-color=282a36cc
ring-clear-color=ffb86c
text-clear-color=ffb86c

show-failed-attempts
