//-*- mode: jsonc -*-
{
    "layer": "top", 
    "position": "top", 
    "height": 30, 
    "spacing": 4, 

    // Choose the order of the modules
    "modules-left": [
        "mango/workspaces",
        "custom/sep",
        "mango/layout",
        "custom/sep",
        "mango/window",
        "custom/sep"
    ],
    "modules-center": [
    ],

    "modules-right": [
        "custom/sep",
        "network",
        "custom/sep",
        "cpu",
        "custom/sep",
        "memory",
        "custom/sep",
        "clock",
        "custom/sep",
        "battery",
        "custom/sep",
        "pulseaudio",
        "custom/sep",
        "tray",
    ],

    // Modules configuration
    "mango/workspaces": {
        "all-outputs": true,
        "warp-on-scroll": true,
        "format": "{icon}",
        "format-icons": {
          "1": "",
          "2": "",
          "3": "",
          "4": "",
          "5": "",
        },
        "on-click":"activate",
        "on-click-right":"toggle",
        "overview-label":""
    },
    "mango/window" : {
        "max-length": 30,
        "seperate-outputs": false
    },
    "pulseaudio": {
      "format": "Vol:{volume}%",
      "format-muted": "",
      "format-bluetooth":"{icon}:{volume}%"
    },
    "tray": {
        // "icon-size": 21,
        "spacing": 10,
        // "icons": {
        //   "blueman": "bluetooth",
        //   "TelegramDesktop": "$HOME/.local/share/icons/hicolor/16x16/apps/telegram.png"
        // }
    },
    "clock": {
        "format": " {:L%H:%M}",
        "format-alt": " {:L%b%d·%A}"
    },
    "cpu": {
        "format": " :{usage}%",
        "tooltip": false
    },
    "memory": {
        "format": " :{used:0.1f}G"
    },
    "disk": {
        "interval": 60,
        "path": "/",
        "format": "Disk: {free}"
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} :{capacity}% {time}",
        "format-plugged": "{capacity}% ",
        "format-alt": "Bat {capacity}%",
        "format-time": "{H}:{M}",
        "format-icons": ["", "", "", "", ""]
    },
    "network": {
        "format": " {essid}:{signalStrength}%",
        "format-disconnected": "Disconnected ⚠"
    },
    "custom/sep": {
        "format" : "|",
        "interval" : 0
    }
}
